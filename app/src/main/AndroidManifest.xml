<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Roon's SOOD discovery answers by multicast/broadcast, and Android drops
         both before they reach userspace unless a MulticastLock is held. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The app IS the Roon extension: its pairing, library snapshot and play
         history live in this process, so it has to survive the screen going
         off. See RemoteService for why this is a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Needed to offer an in-app update. It does not let this app install
      anything by itself: it lets it ASK, and Android's installer then shows
      the usual confirmation. The user also has to allow "install unknown apps"
      for this app once, which the installer prompts for.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The dial's microphone. Asked for at the moment it is first tapped, not
         at launch: an app that wants the microphone before you have used it is
         an app you should be suspicious of. Nothing is recorded or kept — the
         recogniser hands back a string and the audio is gone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      From Android 11 an app cannot see another package unless it says which it
      is looking for. Without this the speech recogniser is invisible, and
      SpeechRecognizer.isRecognitionAvailable() answers false on a phone that
      has one — so the microphone would report "no speech recognition on this
      device" and nobody would know why.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The dial, as its own launcher icon.

          One install, two icons. Dial for Roon used to be a separate app,
          which meant a second Roon extension to approve and a second pairing
          to keep for what is one person controlling one room. Here it is a
          second face on the extension that is already running: enable one
          thing in Roon, get both.

          taskAffinity is its own, so the dial and the main app are separate
          entries in Recents rather than one stack where Back from the dial
          lands in a WebView the user never opened.
        -->
        <activity
            android:name=".dial.DialActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:icon="@mipmap/ic_dial"
            android:label="@string/dial_name"
            android:launchMode="singleTop"
            android:taskAffinity="com.musicd.lite.dial"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          What Assistant binds to before it can say anything to this app.

          "Hey Google, pause" already worked without this, because an ACTIVE
          media session is reachable for transport. "Play <something> on
          MusicD" is not transport: Assistant has to find the app by name,
          start it, and get its session — and a MediaBrowserService is the only
          route to that. Android's guidance: "You must return a BrowserRoot in
          order to allow the Assistant to send commands to your media session."

          Not exported to the world by accident: a MediaBrowserService is bound
          by name through this action, which is how every media player on
          Android is discovered by Assistant, Auto and Wear.
        -->
        <service
            android:name=".BrowserService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!--
          Playing something without opening anything.

          MEDIA_PLAY_FROM_SEARCH is Android's own "play <something>" intent,
          fired by car head units, launchers and assistants. Declaring it is
          the only way this app can be offered as an answer to that at all —
          and it is NOT the same as "Hey Google, play X on MusicD", which is
          App Actions and needs Play Store publication plus a Google review of
          a shortcuts.xml. A hand-signed, hand-installed APK gets neither.

          VOICE_COMMAND is ours, and it is the one that will be used: a phrase
          plus an optional room, run through the same obey() as the dial's
          microphone. Exported because an intent nothing can send is not an
          integration — see the class for what that does and does not risk.
        -->
        <activity
            android:name=".VoiceIntentActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.musicd.lite.android.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          A random album from the notification shade: pull down, tap, a record
          starts. The app's most-used action without opening the app.
        -->
        <service
            android:name=".RandomAlbumTile"
            android:exported="true"
            android:icon="@drawable/ic_tile_random"
            android:label="@string/tile_random_album"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          Now playing on the home screen. Redrawn when Roon's zone feed moves
          rather than on a timer — see widget_now_playing_info.xml.
        -->
        <receiver
            android:name=".NowPlayingWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_playing_info" />
        </receiver>

        <!--
          The dial as a widget: the same DialView, drawn to an image, with tap
          targets laid over the controls it drew. Exported because its volume
          buttons arrive as broadcasts from the launcher.
        -->
        <receiver
            android:name=".DialWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.musicd.lite.dial.VOLUME_UP" />
                <action android:name="com.musicd.lite.dial.VOLUME_DOWN" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dial_info" />
        </receiver>

        <!-- The share card leaves the app as a content:// URI: an image cannot
             be put on the clipboard or into a share sheet as raw bytes. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shares"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".RemoteService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
