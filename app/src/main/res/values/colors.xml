<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The front-end's own background, so the window never flashes a
         different colour behind the page while it loads. -->
    <color name="app_background">#FF17191C</color>
    <!-- Rouen's icon is drawn on its own graphite ground (#17191c, the
         page's --bg), and the foreground layer is that whole square, so the
         background behind it must be the same colour or the launcher's
         parallax shows a seam at the edge. -->
    <color name="icon_background">#FF17191C</color>
    <color name="dial_icon_background">#FF101418</color>
</resources>
