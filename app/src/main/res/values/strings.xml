<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      THE APP'S NAME. It is back to what the project is actually called.

      For a while this was a voice target and the name was chosen to survive
      being said to a phone, which turned out to be its own small research
      project. Four were tried and each failed differently:

        "MusicD Remote Lite"  three words, and a trailing capital letter no
                              speech model has a place for -> heard as
                              "Music d remote light"
        "Roon"                outside the speech lexicon    -> heard as "rune"
        "Remote"              a Google feature              -> opened the TV
                              remote instead of this app
        "Jukebox"             worked
        "Roulette"            (a second launcher entry, since removed) was
                              heard perfectly and answered with facts about
                              the casino game

      None of that applies any more. Voice control beyond transport was
      abandoned — Gemini declines to play anything in a third-party app, see
      BrowserService — so the name no longer has to win an argument with a
      speech model, and it can just be the product's name again. The rule that
      used to guard it (VoiceName) went with the feature; this comment is what
      is left, so the history is not rediscovered the hard way.
    -->
    <string name="app_name">MusicD Remote</string>
    <string name="dial_name">Dial for Roon</string>

    <string name="tile_random_album">Random album</string>

    <!-- The plain bar widget. -->
    <string name="widget_bar_description">Now playing, with transport. Tap the cover for a random album.</string>

    <!--
      The dial widget. These two names are fixed by the layout synced from
      Dial for Roon, so they are what they are; see tools/dial-upstream.json.
    -->
    <string name="widget_artwork">Album artwork</string>
    <string name="widget_description">The dial: album art in a volume ring, with transport and volume.</string>
</resources>
