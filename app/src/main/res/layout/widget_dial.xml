<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget is the app's dial drawn to an image, with invisible tap targets
  over it. RemoteViews cannot host a custom view or follow a gesture, so the
  ring reports the level and its two sides raise and lower instead.

  The controls row is positioned at runtime with setViewPadding, from the same
  geometry DialView uses to draw. A fixed grid of thirds cannot do it: four
  controls occupy the middle 45% of the dial, so thirds put every one of them
  in the wrong cell — tapping the microphone skipped a track instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dial_widget_background">

    <ImageView
        android:id="@+id/widget_dial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_artwork"
        android:scaleType="fitCenter" />

    <!-- The ring: its two sides are volume, the middle opens the app. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_volume_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/widget_open"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2" />

        <FrameLayout
            android:id="@+id/widget_volume_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- On top, inset to exactly the band the four controls are drawn in. -->
    <FrameLayout
        android:id="@+id/widget_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/widget_play_pause"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/widget_voice"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
